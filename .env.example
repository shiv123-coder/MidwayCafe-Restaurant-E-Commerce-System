APP_NAME="Restaurant Ecommerce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Set to * to trust all proxies when behind a load balancer
TRUSTED_PROXIES=null

LOG_CHANNEL=stack

# PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rms2
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# bKash Payment Gateway
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://checkout.sandbox.bka.sh/v1.2.0-beta

# SSLCommerz Payment Gateway
STORE_ID=
STORE_PASSWORD=
API_DOMAIN_URL=https://sandbox.sslcommerz.com
IS_LOCALHOST=true

# Google API Configuration
GOOGLE_MAPS_API_KEY=
